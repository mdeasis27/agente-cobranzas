# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Se inyecta automáticamente via Vercel Marketplace → Neon integration
# Para local: copiar de `vercel env pull .env.local` tras conectar la integración
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── OpenRouter (modelos gratuitos) ────────────────────────────────────────────
# Regístrate en https://openrouter.ai → API Keys → crear clave
# Modelo usado: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Crea tu bot con @BotFather en Telegram y copia el token aquí
TELEGRAM_BOT_TOKEN=123456789:AAF...

# ── Seguridad del Cron ────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
# Vercel lo inyecta automáticamente en el header Authorization al llamar el cron
CRON_SECRET=genera-un-secreto-aleatorio-aqui
