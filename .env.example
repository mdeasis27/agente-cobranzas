# ── OpenRouter (modelos gratuitos) ────────────────────────────────────────────
# Regístrate en https://openrouter.ai → API Keys → crear clave
# Modelo usado: meta-llama/llama-3.3-70b-instruct:free
# Ver todos los modelos gratuitos: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=sk-or-v1-...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Crea tu bot con @BotFather en Telegram y copia el token aquí
TELEGRAM_BOT_TOKEN=123456789:AAF...

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID del sheet (aparece en la URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Credenciales de la Service Account de Google Cloud (JSON completo en una línea)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Seguridad del Cron ────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
# Vercel lo inyecta automáticamente en el header Authorization al llamar el cron
CRON_SECRET=genera-un-secreto-aleatorio-aqui
